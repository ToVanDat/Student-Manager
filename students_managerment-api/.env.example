# Backend API — local development.
# Copy to .env and replace placeholders. Never commit the real .env file.
NODE_ENV=development
PORT=3000

# Set to 1 only when the API is reachable exclusively through one trusted Nginx proxy.
# Nginx must overwrite X-Real-IP and set X-Forwarded-For from $remote_addr.
# This also enables client-IP-aware Socket.IO handshake limits (300 attempts/minute/IP).
# Leave empty when accessing the backend directly; forwarded headers are then ignored.
TRUST_PROXY_HOPS=

# Native local backend uses localhost. Docker Compose overrides DB_HOST to "postgres".
# Keep the existing database name and credentials; do not reset or recreate the database.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=students_managerment
DB_USER=your_database_user
DB_PASSWORD=replace_with_your_database_password

# Native local backend uses localhost. Docker Compose overrides REDIS_HOST to "redis".
REDIS_HOST=localhost
REDIS_PORT=6379

# Generate a strong random secret locally; never commit the real value.
JWT_SECRET=replace_with_a_long_random_secret

# Required by progressive password-login protection. Generate at least 32 random bytes.
# Keep the real value only in the ignored .env file; leave blank in this template.
AUTH_RATE_LIMIT_HASH_SECRET=

# Same OAuth Web Client ID as VITE_GOOGLE_CLIENT_ID; not a client secret.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Exact browser origin (no trailing slash).
FRONTEND_URL=http://localhost:5173
# Comma-separated CORS allowlist; include only origins you actively use.
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173,https://student-manager.local

# Optional mail provider.
RESEND_API_KEY=

# Configure only if WebAuthn/passkey is enabled for this environment.
WEBAUTHN_ORIGIN=http://localhost:5173
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Student Manager

# Ollama assistant. Native backend: loopback. Docker Compose defaults to
# host.docker.internal and explicitly opts in to that Docker host-gateway hostname.
# Any other non-loopback HTTP endpoint is rejected; remote Ollama must use HTTPS.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_ALLOW_DOCKER_HOST=false
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
