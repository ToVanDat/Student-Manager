# Backend API — local development
NODE_ENV=development
PORT=3000

# PostgreSQL (keep aligned with the existing database; do not reset data)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=students_managerment
DB_USER=your_database_user
DB_PASSWORD=replace_with_your_database_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Generate a strong random secret locally; never commit the real value.
JWT_SECRET=replace_with_a_long_random_secret

# Must be the same OAuth client ID used by VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Exact browser origin for CORS / OAuth origin checks (no trailing slash).
FRONTEND_URL=http://localhost:5173

# Optional mail provider
RESEND_API_KEY=
