# Frontend (Vite) — copy to .env.local and set values for your machine.
# Only public/browser-safe values belong here. Never put GOOGLE_CLIENT_SECRET or JWT_SECRET in VITE_*.

# Local HTTP with Vite + API on port 3000:
VITE_API_BASE_URL=http://localhost:3000
VITE_GOOGLE_CLIENT_ID=38499596029-h8ff2pbip076q6jodjmi4g65f4r7qrjg.apps.googleusercontent.com

