# Student Manager Coturn configuration.
# Copy to /etc/turnserver.conf and replace the placeholders before starting.
# Keep static-auth-secret identical to backend TURN_SHARED_SECRET.
# Do not use long-term credentials (lt-cred-mech) with this REST shared-secret setup.

listening-port=3478
tls-listening-port=5349

fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_THE_SAME_64_HEX_CHAR_BACKEND_TURN_SHARED_SECRET

realm=turn.smartsmanage.com
server-name=turn.smartsmanage.com

min-port=49160
max-port=49200

cert=/etc/turnserver/tls/fullchain.pem
pkey=/etc/turnserver/tls/privkey.pem

stale-nonce=600
total-quota=20
user-quota=4

no-cli
no-loopback-peers
no-multicast-peers

proc-user=turnserver
proc-group=turnserver

# Only configure external-ip when the VPS is behind NAT and Coturn sees a
# private interface address. Format: external-ip=PUBLIC_IP/PRIVATE_IP
# external-ip=203.0.113.10/10.0.0.10

# Keep relay logging on the system journal; avoid verbose packet logging.
